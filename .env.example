# Juwan CTI v3.0 — Environment Configuration
# Copy this to .env and fill in your values

# ─── Environment ──────────────────────────────────────────────────
ENVIRONMENT=dev
DEBUG=True

# ─── API ──────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ─── PostgreSQL (Docker) ──────────────────────────────────────────
POSTGRES_DB=cti_v3
POSTGRES_USER=cti_user
POSTGRES_PASSWORD=cti_secret
DATABASE_URL=postgresql+asyncpg://cti_user:cti_secret@localhost:5432/cti_v3
DATABASE_SYNC_URL=postgresql+psycopg2://cti_user:cti_secret@localhost:5432/cti_v3

# ─── Redis (Celery) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FILE=logs/cti_v3.log

# ─── Detection Thresholds (v2 channels) ───────────────────────────
EMAIL_THRESHOLD=0.50
URL_THRESHOLD=0.45
CHAT_THRESHOLD=0.50

# ─── Detection Thresholds (v3 channels) ───────────────────────────
VOICE_THRESHOLD=0.50
IMAGE_DEEPFAKE_THRESHOLD=0.60
IMAGE_TAMPER_THRESHOLD=0.55
AI_ORIGIN_THRESHOLD=0.65

# ─── Ensemble Channel Weights ─────────────────────────────────────
WEIGHT_EMAIL=0.35
WEIGHT_URL=0.25
WEIGHT_CHAT=0.15
WEIGHT_VOICE=0.15
WEIGHT_IMAGE=0.10

# ─── Threat Level Thresholds ──────────────────────────────────────
THREAT_HIGH_SCORE=0.60
THREAT_HIGH_INDICATORS=2
THREAT_MEDIUM_SCORE=0.40
THREAT_MEDIUM_INDICATORS=1

# ─── Campaign Clustering ──────────────────────────────────────────
CAMPAIGN_CLUSTER_INTERVAL=900
CAMPAIGN_LSH_THRESHOLD=0.50
CAMPAIGN_MINHASH_PERMS=128
CAMPAIGN_LOOKBACK_HOURS=24

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
