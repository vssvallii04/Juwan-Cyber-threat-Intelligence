# Cyber Threat Intelligence API - Environment Configuration
# Copy this file to .env and customize values for your environment

# Environment: dev, staging, prod
ENVIRONMENT=dev

# Debug mode
DEBUG=True

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# Security - Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/cti_api.log

# Model Thresholds for threat classification
EMAIL_THRESHOLD=0.50
URL_THRESHOLD=0.45
CHAT_THRESHOLD=0.50

# Ensemble Threat Level Thresholds
THREAT_HIGH_SCORE=0.60
THREAT_HIGH_INDICATORS=2
THREAT_MEDIUM_SCORE=0.40
THREAT_MEDIUM_INDICATORS=1
